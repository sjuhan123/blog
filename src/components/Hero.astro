---
import { Icon } from 'astro-icon/components';
import { getEntry } from 'astro:content';
import siteConfig from '../data/site-config';

const hero = siteConfig.hero;
const bio = await getEntry('about', 'hero');
const { Content } = await bio.render();
---

{
  hero && (
    <section class="mb-16 flex w-full flex-col gap-2 sm:mb-24">
      {hero.title && (
        <h1 class="font-serif text-3xl font-medium leading-tight sm:text-5xl sm:leading-tight">
          {hero.title}
        </h1>
      )}
      {hero.image?.src && (
        <figure>
          <img
            class="w-full"
            src={hero.image.src}
            loading="lazy"
            decoding="async"
            alt={hero.image.alt || ''}
          />
          {hero.image.caption && (
            <figcaption class="mt-1.5 text-xs sm:text-sm">
              {hero.image.caption}
            </figcaption>
          )}
        </figure>
      )}
      <div class="mdx prose prose-dante mb-6 max-w-none text-lg">
        <Content />
      </div>
      {hero.socialLinks && hero.socialLinks.length > 0 && (
        <div class="flex flex-wrap gap-3">
          {hero.socialLinks.map((link) => (
            <a href={link.href}>
              <Icon name={link.name} size={17} />
            </a>
          ))}
        </div>
      )}
    </section>
  )
}
