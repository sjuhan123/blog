---
import type { GetStaticPathsOptions, Page } from 'astro';
import { type CollectionEntry, getCollection } from 'astro:content';

import PostPreview from '../../components/PostPreview.astro';
import TagFilter from '../../components/TagFilter.astro';
import siteConfig from '../../data/site-config';
import BaseLayout from '../../layouts/BaseLayout.astro';
import {
  getAllTags,
  getPostsByTag,
  isKoreanTag,
  sortItemsByDateDesc,
} from '../../utils/data-utils';

export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
  const posts = (await getCollection('blog')).sort(sortItemsByDateDesc);
  return paginate(posts, { pageSize: siteConfig.postsPerPage || posts.length });
}

type Props = { page: Page<CollectionEntry<'blog'>> };

const { page } = Astro.props;
const blog = page.data;
const allPosts = await getCollection('blog');
const tags = getAllTags(allPosts)
  .sort((tagA, tagB) => {
    const aIsKorean = isKoreanTag(tagA.name);
    const bIsKorean = isKoreanTag(tagB.name);
    if (aIsKorean !== bIsKorean) return aIsKorean ? -1 : 1;
    return (
      getPostsByTag(allPosts, tagB.slug).length -
      getPostsByTag(allPosts, tagA.slug).length
    );
  })
  .map((tag) => ({ ...tag, count: getPostsByTag(allPosts, tag.slug).length }));

const blogSchema = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: siteConfig.title,
  url: new URL('/blog/', Astro.site).toString(),
  description: '일상과 개발 이야기를 기록하는 공간입니다.',
  author: {
    '@type': 'Person',
    name: '한승주',
  },
};
---

<BaseLayout
  title="글"
  description="일상과 개발 이야기를 기록하는 공간입니다."
  showHeader={false}
  structuredData={blogSchema}
>
  <TagFilter tags={tags} totalCount={allPosts.length} />
  {blog.map((post) => <PostPreview post={post} class="mb-10 sm:mb-12" />)}
</BaseLayout>
